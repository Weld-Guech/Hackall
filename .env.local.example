# Copie ce fichier en .env.local et remplis tes propres valeurs.
# .env.local est déjà ignoré par Git (voir .gitignore) — ne le commite jamais.

ELEVENLABS_API_KEY=colle_ta_cle_ici
# Voix par défaut, utilisée par un client si son propre Voice ID (réglable
# depuis /admin ou /parametres) est laissé vide.
ELEVENLABS_VOICE_ID=colle_l_id_de_ta_voix_ici

# Mot de passe pour accéder au dashboard agence (/admin), où tu crées les
# accès identifiant/mot de passe de tes clients.
ADMIN_PASSWORD=change_moi

# Clé secrète utilisée pour signer les sessions de connexion (admin et
# clients). Mets une longue chaîne aléatoire, par ex. générée avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplace_par_une_longue_chaine_aleatoire

# --- Cache audio TTS (voir docs/TTS.md) ---
# Sur le VPS, ces lignes sont ajoutées automatiquement par :
#   node scripts/tts-setup.mjs
# Dossier du cache audio partagé entre restaurants (hors du build Next).
TTS_CACHE_DIR=/home/ubuntu/hackall-tts-cache
# eleven_multilingual_v2 (meilleur sur les prénoms) ou eleven_flash_v2_5 (2x moins cher).
TTS_MODEL_ID=eleven_multilingual_v2
# Au-delà de ce délai, l'annonce part avec la voix de secours Piper.
ELEVENLABS_TIMEOUT_MS=2000
PIPER_BIN=/home/ubuntu/piper/piper
PIPER_MODEL=/home/ubuntu/piper-voices/fr_FR-siwis-medium.onnx
# Secret partagé entre le serveur et les scripts de pré-génération.
TTS_INTERNAL_TOKEN=genere_par_tts_setup

# Copie ce fichier en .env.local et remplis tes propres valeurs.
# .env.local est déjà ignoré par Git (voir .gitignore) — ne le commite jamais.

ELEVENLABS_API_KEY=colle_ta_cle_ici
# Voix par défaut, utilisée par un client si son propre Voice ID (réglable
# depuis /admin ou /parametres) est laissé vide.
ELEVENLABS_VOICE_ID=colle_l_id_de_ta_voix_ici

# Mot de passe pour accéder au dashboard agence (/admin), où tu crées les
# accès identifiant/mot de passe de tes clients.
ADMIN_PASSWORD=change_moi

# Clé secrète utilisée pour signer les sessions de connexion (admin et
# clients). Mets une longue chaîne aléatoire, par ex. générée avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplace_par_une_longue_chaine_aleatoire
